#!/usr/bin/env python3
"""Test-only stand-in for util-linux flock (absent on macOS).

`flock -n FD` locks the open file description inherited as FD (the lock outlives this process, held by the
parent's descriptor, as with util-linux); `flock [-n] PATH COMMAND...` holds a lock on PATH while COMMAND runs."""
import fcntl
import os
import subprocess
import sys

args = sys.argv[1:]
flags = fcntl.LOCK_EX
if args and args[0] == '-n':
    flags |= fcntl.LOCK_NB
    args = args[1:]
try:
    if len(args) == 1 and args[0].isdigit():
        fcntl.flock(int(args[0]), flags)
        sys.exit(0)
    fd = os.open(args[0], os.O_RDWR | os.O_CREAT)
    fcntl.flock(fd, flags)
    sys.exit(subprocess.run(args[1:]).returncode)
except BlockingIOError:
    sys.exit(1)
