#!/usr/bin/env python3
"""Test-only stand-in for coreutils `timeout SECONDS COMMAND...` (absent on macOS): exit 124 on timeout."""
import subprocess
import sys

try:
    sys.exit(subprocess.run(sys.argv[2:], timeout=float(sys.argv[1])).returncode)
except subprocess.TimeoutExpired:
    sys.exit(124)
